#!/usr/bin/env sh

# Repo root (.husky/ is one level down)
cd "$(dirname "$0")/.." || exit 1

# Cursor / VS Code / GitHub Desktop use a minimal PATH — bun is often missing
export PATH="$PWD/node_modules/.bin:$PWD/client/node_modules/.bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if [ ! -f ".husky/_/pre-commit" ]; then
	echo "husky: git hooks are not installed. Run: bun install (at the repo root)"
	exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
	echo "husky: bun was not found in PATH (required for lint-staged formatters)"
	exit 1
fi

exec lint-staged
